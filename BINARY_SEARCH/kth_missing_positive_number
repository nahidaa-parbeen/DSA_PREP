class Solution {
public:
    int findKthPositive(vector<int>& arr, int k) {
        int n=arr.size();
        int l=0,h=n-1;
        while(l<=h){
            int mid=l+(h-l)/2;
            int cnt;
            cnt=arr[mid]-(mid+1);
            if(cnt>=k){
                h=mid-1;
            }
            else{
                l=mid+1;
            }
        }
        return h+k+1;
    }
};
